# ---- required: without this the forms refuse to submit ----------------------
# Any Postgres will do — Neon, Supabase, Vercel Postgres, your own.
# Use the POOLED connection string on serverless.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- optional: email alert on every new lead --------------------------------
# Without these the lead is still saved; you just are not pinged about it.
# Always set these two:
LEADS_EMAIL_TO="hello@stillyours.in"
LEADS_EMAIL_FROM="StillYours <hello@stillyours.in>"

# then pick ONE way to send.

# (a) Resend — no SMTP, no app password. Takes priority if set.
RESEND_API_KEY=""

# (b) Any SMTP server, including your own Gmail. For Gmail:
#     SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#     SMTP_PASS=<16-character Google App Password, NOT your normal password>
#     and set LEADS_EMAIL_FROM to that same Gmail address.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
